        }
      ]
    },
    {
      "id": "claim_ee4f4dd5bd75467e9de5791b23cd5b33",
      "statement": "The repository does not currently implement a concrete secret-manager-to-Kubernetes synchronization, rotation, or workload-refresh mechanism; secret references and infrastructure responsibilities are documented only as intended boundaries in an early scaffold.",
