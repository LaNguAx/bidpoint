        }
      ]
    },
    {
      "id": "claim_25e6b7fa8e384efb8b9e548ab98aa7af",
      "statement": "Secret-related ownership is deliberately split: `infra/` creates KMS keys and secret-manager resources, `gitops/` commits only workload secret references, and authorized out-of-band operations place actual values in AWS Secrets Manager or Vault; passwords, tokens, API keys, and credential-bearing connection strings must never be committed.",
      "evidence": [
        {
          "resource": "repo://AGENTS.md#L42-L46",
          "version": "repo-lines-v1:sha256:eea9768582c0686c2b5a622c50bb1a55e2b730e3fa775b749b35a546ef9ef008:"
