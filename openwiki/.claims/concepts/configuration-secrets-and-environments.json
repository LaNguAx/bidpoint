    {
      "id": "claim_aed9687c45d9483eab21c70d276bc9ba",
      "statement": "Frontend configuration is owned by the independent web or mobile workspace, never by the backend-only root `config/`, and must remain non-sensitive because browser artifacts, mobile bundles, and device traffic are inspectable by users.",
